--- /dev/null
+++ b/vllm/v1/engine/qos_control.py
@@ -0,0 +1,127 @@
+import itertools
+import os
+from typing import Any
+
+from llm_proxy_qos import ControlServer, qos_id, reply_message
+from vllm.logger import init_logger
+from vllm.v1.core.sched.interface import PauseState
+from vllm.v1.core.sched.request_queue import SchedulingPolicy
+from vllm.v1.engine import EngineCoreOutputs, EngineCoreRequestType
+from vllm.v1.request import Request, RequestStatus
+
+logger = init_logger(__name__)
+
+
+def create_control_server(engine: Any, is_data_parallel: bool) -> ControlServer | None:
+    path = os.environ.get("VLLM_QOS_CONTROL_SOCKET")
+    if not path:
+        return None
+    if is_data_parallel and "{rank}" not in path:
+        raise ValueError(
+            "VLLM_QOS_CONTROL_SOCKET must contain {rank} when the data parallel "
+            f"size is greater than 1 (got {path!r})"
+        )
+    path = path.replace("{rank}", str(engine.engine_index))
+    logger.info("QoS control socket listening on %s", path)
+    return ControlServer(
+        path,
+        lambda: engine.input_queue.put_nowait((EngineCoreRequestType.WAKEUP, None)),
+    )
+
+
+def run_commands(engine: Any) -> None:
+    if engine.control_server is None:
+        return
+    scheduler = engine.scheduler
+    for command in engine.control_server.take_commands():
+        scheduler.suspension.apply(command)
+        engine.control_server.reply(
+            reply_message(command, lambda: info(engine), lambda: stats(scheduler))
+        )
+
+
+def info(engine: Any) -> dict:
+    scheduler = engine.scheduler
+    return {
+        "engine": "vllm",
+        "model": engine.vllm_config.model_config.served_model_name,
+        "data_parallel_rank": engine.engine_index,
+        "max_running_requests": scheduler.max_num_running_reqs,
+        "priority_scheduling": scheduler.policy == SchedulingPolicy.PRIORITY,
+        "kv_cache_tokens": scheduler.cache_config.num_gpu_blocks * scheduler.block_size,
+    }
+
+
+def stats(scheduler: Any) -> list[dict]:
+    return [
+        {
+            "id": request_qos_id,
+            "state": "suspended"
+            if request_qos_id in scheduler.suspension.ids
+            else "running"
+            if request.status == RequestStatus.RUNNING
+            else "waiting",
+            "prompt_tokens": request.num_prompt_tokens,
+            "output_tokens": request.num_output_tokens,
+        }
+        for request in scheduler.requests.values()
+        if not request.is_finished()
+        and (request_qos_id := qos_id(request.request_id)) is not None
+    ]
+
+
+def publish_events(engine: Any) -> None:
+    if engine.control_server is None:
+        return
+    suspension = engine.scheduler.suspension
+    running = {
+        request_qos_id: request
+        for request in engine.scheduler.running
+        if request.status == RequestStatus.RUNNING
+        and (request_qos_id := qos_id(request.request_id)) is not None
+        and request_qos_id not in suspension.ids
+    }
+    engine.control_server.publish(
+        running,
+        Request.is_finished,
+        lambda request: suspension.contains(request.request_id),
+    )
+
+
+def has_only_suspended_requests(scheduler: Any) -> bool:
+    if not scheduler.suspension.ids or scheduler.has_finished_requests():
+        return False
+    requests = scheduler.running
+    if scheduler.pause_state != PauseState.PAUSED_NEW:
+        requests = itertools.chain(scheduler.running, scheduler.requests.values())
+    return all(
+        scheduler.suspension.contains(request.request_id)
+        or request.status == RequestStatus.WAITING_FOR_STREAMING_REQ
+        for request in requests
+    )
+
+
+def preempt_suspended(scheduler: Any, timestamp: float) -> Request | None:
+    for request in reversed(scheduler.running):
+        if scheduler.suspension.contains(
+            request.request_id
+        ) and scheduler._request_blocks_can_be_freed(request):
+            scheduler.running.remove(request)
+            scheduler._preempt_request(
+                request, timestamp, drop_stale_output=scheduler.requires_kv_delivery
+            )
+            return request
+    return None
+
+
+def start_wave(engine: Any) -> None:
+    if (
+        engine.control_server is not None
+        and engine.has_coordinator
+        and not engine.engines_running
+        and engine.scheduler.pause_state == PauseState.UNPAUSED
+    ):
+        engine.engines_running = True
+        engine.output_queue.put_nowait(
+            (-1, EngineCoreOutputs(start_wave=engine.current_wave))
+        )
