--- /dev/null
+++ b/sglang/srt/managers/qos_control.py
@@ -0,0 +1,394 @@
+import os
+import socket
+from contextlib import suppress
+from typing import TYPE_CHECKING, List, Optional
+
+import zmq
+
+from llm_proxy_qos import (
+    Command,
+    ControlServer,
+    Suspension,
+    prefill_totals,
+    qos_id,
+    reply_message,
+    token_counts,
+)
+from sglang.srt.disaggregation.utils import DisaggregationMode
+from sglang.srt.managers.io_struct import AbortReq
+from sglang.srt.managers.scheduler_components.idle_sleeper import IdleSleeper
+from sglang.srt.mem_cache.common import release_kv_cache
+from sglang.srt.runtime_context import get_model, get_serving
+from sglang.utils import TypeBasedDispatcher
+
+MAX_PREFIX_MATCHED_WAITING_REQUESTS = 32
+
+if TYPE_CHECKING:
+    from sglang.srt.managers.hisparse_coordinator import HiSparseCoordinator
+    from sglang.srt.managers.schedule_batch import Req, ScheduleBatch
+    from sglang.srt.managers.schedule_policy import PrefillAdder
+    from sglang.srt.managers.scheduler import Scheduler
+
+
+class QosControl:
+    def __init__(self, scheduler: "Scheduler"):
+        self.scheduler = scheduler
+        self.suspension = Suspension()
+        self.parked_reqs: List["Req"] = []
+        self.pausing_reqs: List["Req"] = []
+        self.server: Optional[ControlServer] = None
+        self.short_prefill_req_ids: set[int] = set()
+        scheduler._request_dispatcher += TypeBasedDispatcher([(Command, self.execute)])
+        path = os.environ.get("SGLANG_QOS_CONTROL_SOCKET")
+        self.is_enabled = bool(path)
+        if not path:
+            return
+        ps = scheduler.ps
+        if ps.pp_size > 1 or scheduler.disaggregation_mode != DisaggregationMode.NULL:
+            raise ValueError(
+                "SGLANG_QOS_CONTROL_SOCKET does not support pipeline parallelism "
+                "or prefill-decode disaggregation"
+            )
+        if ps.dp_size > 1 and "{rank}" not in path:
+            raise ValueError(
+                "SGLANG_QOS_CONTROL_SOCKET must contain {rank} when dp_size > 1"
+            )
+        if (ps.pp_rank, ps.attn_tp_rank, ps.attn_cp_rank) != (0, 0, 0):
+            return
+        self.wake_reader, wake_writer = socket.socketpair()
+        self.wake_reader.setblocking(False)
+        wake_writer.setblocking(False)
+        if isinstance(scheduler.idle_sleeper, IdleSleeper):
+            scheduler.idle_sleeper.poller.register(self.wake_reader, zmq.POLLIN)
+
+        def wake():
+            with suppress(BlockingIOError):
+                wake_writer.send(b"\0")
+
+        self.server = ControlServer(path.replace("{rank}", str(ps.dp_rank or 0)), wake)
+
+    def commands(self) -> List[Command]:
+        if self.server is None:
+            return []
+        with suppress(BlockingIOError):
+            self.wake_reader.recv(65536)
+        return self.server.take_commands()
+
+    def execute(self, command: Command):
+        self.suspension.apply(command)
+        if self.server is not None:
+            self.server.reply(reply_message(command, self.info, self.stats))
+
+    def info(self) -> dict:
+        scheduler = self.scheduler
+        return {
+            "engine": "sglang",
+            "model": get_serving().served_model_name or get_model().model_path,
+            "data_parallel_rank": scheduler.ps.dp_rank,
+            "max_running_requests": scheduler.max_running_requests,
+            "priority_scheduling": scheduler.enable_priority_scheduling,
+            "kv_cache_tokens": scheduler.max_total_num_tokens,
+        }
+
+    def stats(self) -> List[dict]:
+        scheduler = self.scheduler
+        running_reqs = scheduler.collect_inflight_reqs() | {scheduler.chunked_req}
+        live_reqs = {
+            *running_reqs,
+            *scheduler.waiting_queue,
+            *self.parked_reqs,
+            *self.pausing_reqs,
+        }
+        return [
+            {
+                "id": qos_id(req.rid),
+                "state": (
+                    "suspended"
+                    if self.is_suspended(req)
+                    else "running"
+                    if req in running_reqs
+                    else "waiting"
+                ),
+                "prompt_tokens": len(req.origin_input_ids),
+                "output_tokens": len(req.output_ids),
+            }
+            for req in live_reqs
+            if req is not None and not req.finished() and qos_id(req.rid)
+        ]
+
+    def is_suspended(self, req: "Req") -> bool:
+        return (
+            self.suspension.contains(req.rid)
+            and req.to_finish is None
+            and not req.finished()
+        )
+
+    def park_if_suspended(self, req: "Req") -> bool:
+        if not self.is_suspended(req):
+            return False
+        self.parked_reqs.append(req)
+        return True
+
+    def has_parked_kv(self) -> bool:
+        return any(req.kv.holds_kv for req in [*self.parked_reqs, *self.pausing_reqs])
+
+    def apply_suspension(self, running_batch: "ScheduleBatch") -> "ScheduleBatch":
+        scheduler = self.scheduler
+        if self.is_enabled:
+            self.pause_chunked_req()
+            self.release_paused_prefills()
+        if self.suspension.ids:
+            running_indices, suspended_indices = [], []
+            for index, req in enumerate(running_batch.reqs):
+                if self.is_suspended(req):
+                    suspended_indices.append(index)
+                else:
+                    running_indices.append(index)
+            if suspended_indices:
+                self.parked_reqs += [running_batch.reqs[i] for i in suspended_indices]
+                if not scheduler.spec_algorithm.is_none():
+                    for index in suspended_indices:
+                        self.release_to_prefix_cache(
+                            running_batch.reqs[index],
+                            running_batch.hisparse_coordinator,
+                        )
+                running_batch.filter_batch(keep_indices=running_indices)
+                running_batch.batch_is_full = False
+        if not self.suspension.is_changed:
+            return running_batch
+        self.suspension.is_changed = False
+        waiting_reqs = scheduler.waiting_queue
+        scheduler.waiting_queue = []
+        for req in waiting_reqs:
+            if not self.park_if_suspended(req):
+                scheduler.waiting_queue.append(req)
+        parked_reqs = self.parked_reqs
+        self.parked_reqs = []
+        resumed_reqs = []
+        for req in parked_reqs:
+            if self.is_suspended(req):
+                self.parked_reqs.append(req)
+            elif not req.finished():
+                resumed_reqs.append(req)
+        for req in resumed_reqs:
+            if not req.kv.holds_kv:
+                scheduler._add_request_to_queue(req, is_retracted=req.is_retracted)
+        decode_reqs = [req for req in resumed_reqs if req.kv.holds_kv]
+        if not decode_reqs:
+            return running_batch
+        resumed_batch = scheduler._build_hisparse_decode_batch(decode_reqs)
+        resumed_batch.multimodal_inputs = [req.multimodal_inputs for req in decode_reqs]
+        resumed_batch.token_ids_logprobs = [
+            req.logprob.token_ids_logprob for req in decode_reqs
+        ]
+        if running_batch.is_empty():
+            return resumed_batch
+        running_batch.merge_batch(resumed_batch)
+        return running_batch
+
+    def release_parked_kv(self, running_batch: "ScheduleBatch"):
+        parked_kv_reqs = [req for req in self.parked_reqs if req.kv.holds_kv]
+        if (
+            parked_kv_reqs
+            and running_batch.batch_size() < self.scheduler.max_running_requests
+        ):
+            self.release_to_prefix_cache(parked_kv_reqs[-1])
+            running_batch.batch_is_full = False
+
+    def pause_chunked_req(self):
+        scheduler = self.scheduler
+        chunked_req = scheduler.chunked_req
+        if chunked_req is None or chunked_req.finished():
+            return
+        if self.is_suspended(chunked_req) or self.has_prefill_before(chunked_req):
+            scheduler.chunked_req = None
+            self.pausing_reqs.append(chunked_req)
+
+    def has_prefill_before(self, chunked_req: "Req") -> bool:
+        chunked_priority, chunked_tokens = self.prefill_order_key(
+            chunked_req, remaining_prefill_tokens(chunked_req)
+        )
+        reserve = self.short_prefill_reserve(self.scheduler.chunked_prefill_size)
+        for req in self.prefix_matched_waiting_reqs():
+            tokens = uncached_tokens(req)
+            if tokens <= reserve:
+                continue
+            priority = self.prefill_order_key(req, tokens)[0]
+            if priority < chunked_priority or (
+                priority == chunked_priority
+                and not getattr(req, "qos_has_paused_prefill", False)
+                and tokens < chunked_tokens
+            ):
+                return True
+        return False
+
+    def release_paused_prefills(self):
+        scheduler = self.scheduler
+        in_flight_req_ids = {
+            id(req)
+            for batch, _ in getattr(scheduler, "result_queue", ())
+            for req in batch.reqs
+        }
+        pausing_reqs = self.pausing_reqs
+        self.pausing_reqs = []
+        for req in pausing_reqs:
+            if id(req) in in_flight_req_ids:
+                self.pausing_reqs.append(req)
+                continue
+            req.qos_paused_prefix_tokens = len(req.prefix_indices)
+            req.qos_has_paused_prefill = True
+            self.release_to_prefix_cache(req)
+            scheduler._add_request_to_queue(req, is_retracted=True)
+            if getattr(req, "qos_is_aborted", False):
+                scheduler.abort_request(AbortReq(rid=req.rid))
+
+    def prefill_order_key(self, req: "Req", tokens: int) -> tuple[int, int]:
+        scheduler = self.scheduler
+        priority = (
+            (req.priority or 0) * scheduler.policy.priority_sign
+            if scheduler.enable_priority_scheduling
+            else 0
+        )
+        waited_steps = getattr(req, "qos_waited_prefill_steps", 0)
+        return priority, tokens - waited_steps * scheduler.chunked_prefill_size
+
+    def order_waiting_queue(self):
+        scheduler = self.scheduler
+        if not self.is_enabled or scheduler.chunked_prefill_size is None:
+            return
+        head = sorted(
+            self.prefix_matched_waiting_reqs(),
+            key=lambda req: self.prefill_order_key(req, uncached_tokens(req)),
+        )
+        scheduler.waiting_queue[: len(head)] = head
+
+    def prefix_matched_waiting_reqs(self) -> List["Req"]:
+        scheduler = self.scheduler
+        if getattr(scheduler.tree_cache, "disable", True) or (
+            scheduler.tree_cache.supports_mamba()
+        ):
+            return []
+        reqs = scheduler.waiting_queue[:MAX_PREFIX_MATCHED_WAITING_REQUESTS]
+        for req in reqs:
+            is_matched = (
+                getattr(req, "qos_prefix_match_retraction_count", None)
+                == req.retraction_count
+            )
+            if not is_matched and not (
+                req.is_retracted and req.multimodal_inputs is not None
+            ):
+                req.init_next_round_input(scheduler.tree_cache)
+                req.qos_prefix_match_retraction_count = req.retraction_count
+        return reqs
+
+    def add_chunked_req(
+        self, adder: "PrefillAdder", chunked_req: "Req"
+    ) -> Optional["Req"]:
+        if not self.is_enabled or adder.rem_chunk_tokens is None:
+            return adder.add_chunked_req(chunked_req)
+        reserve = self.short_prefill_reserve(adder.rem_chunk_tokens)
+        self.short_prefill_req_ids = {
+            id(req)
+            for req in self.prefix_matched_waiting_reqs()
+            if uncached_tokens(req) <= reserve
+        }
+        reserve = reserve if self.short_prefill_req_ids else 0
+        adder.rem_chunk_tokens -= reserve
+        chunked_req = adder.add_chunked_req(chunked_req)
+        adder.rem_chunk_tokens += reserve
+        adder.has_unfinished_chunked_req = chunked_req is not None
+        return chunked_req
+
+    def short_prefill_reserve(self, chunk_tokens: int) -> int:
+        scheduler = self.scheduler
+        alignment = scheduler.truncation_align_size or scheduler.page_size
+        return chunk_tokens // 2 // alignment * alignment
+
+    def is_behind_chunked_req(self, adder: "PrefillAdder", req: "Req") -> bool:
+        return (
+            adder.has_unfinished_chunked_req
+            and id(req) not in self.short_prefill_req_ids
+        )
+
+    def release_to_prefix_cache(
+        self, req: "Req", hisparse_coordinator: Optional["HiSparseCoordinator"] = None
+    ):
+        if hisparse_coordinator is not None:
+            hisparse_coordinator.retract_req(req)
+        release_kv_cache(req, self.scheduler.tree_cache)
+        req.reset_for_retract()
+
+    def publish_events(
+        self, batch: Optional["ScheduleBatch"], running_batch: "ScheduleBatch"
+    ):
+        if (
+            batch is not None
+            and batch.forward_mode.is_extend_or_draft_extend_or_mixed()
+        ):
+            for req in batch.reqs:
+                self.count_prefill_start(req)
+            for req in self.scheduler.waiting_queue:
+                req.qos_waited_prefill_steps = (
+                    getattr(req, "qos_waited_prefill_steps", 0) + 1
+                )
+        if self.server is None:
+            return
+        running = {
+            qos_id(req.rid): req
+            for req in [
+                *running_batch.reqs,
+                *(batch.reqs if batch else []),
+                self.scheduler.chunked_req,
+            ]
+            if req is not None
+            and qos_id(req.rid)
+            and not req.finished()
+            and not self.is_suspended(req)
+        }
+        self.server.publish(
+            running, lambda req: req.finished(), self.is_suspended, self.token_counts
+        )
+
+    def count_prefill_start(self, req: "Req"):
+        if getattr(req, "qos_prefill_retraction_count", None) == req.retraction_count:
+            return
+        req.qos_prefill_retraction_count = req.retraction_count
+        req.qos_has_paused_prefill = False
+        cached_tokens = len(req.prefix_indices)
+        paused_prefix_tokens = getattr(req, "qos_paused_prefix_tokens", None)
+        req.qos_paused_prefix_tokens = None
+        if paused_prefix_tokens is None:
+            prefill_totals(req).add(
+                len(req.origin_input_ids) + len(req.output_ids), cached_tokens
+            )
+        else:
+            prefill_totals(req).add(
+                paused_prefix_tokens, min(cached_tokens, paused_prefix_tokens)
+            )
+
+    def token_counts(self, req: "Req") -> dict:
+        return token_counts(
+            len(req.origin_input_ids), len(req.output_ids), prefill_totals(req)
+        )
+
+    def abort(self, recv_req: "AbortReq"):
+        for req in self.pausing_reqs:
+            if recv_req.abort_all or req.rid.startswith(recv_req.rid):
+                req.qos_is_aborted = True
+        parked_reqs = self.parked_reqs
+        self.parked_reqs = []
+        for req in parked_reqs:
+            if not (recv_req.abort_all or req.rid.startswith(recv_req.rid)):
+                self.parked_reqs.append(req)
+            elif not req.finished():
+                if req.kv.holds_kv:
+                    release_kv_cache(req, self.scheduler.tree_cache, is_insert=False)
+                self.scheduler.waiting_queue.append(req)
+
+
+def remaining_prefill_tokens(req: "Req") -> int:
+    return len(req.origin_input_ids) + len(req.output_ids) - len(req.prefix_indices)
+
+
+def uncached_tokens(req: "Req") -> int:
+    return remaining_prefill_tokens(req) - req.host_hit_length
